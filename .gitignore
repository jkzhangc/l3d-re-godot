# Godot 4+ specific ignores
.godot/
/android/

# 本地用户配置（2026-10-08）：每次运行游戏都会自动改写 changelog_seen_version 等字段，
# 属运行副产物、不是源文件；且各人音量/字体/朝向设置本就该各自独立。
# 缺失时 Global._apply_config_file 会静默跳过（用类内默认值），程序首跑 save_config 会自建。
# ⚠ 已跟踪过该文件，需 `git rm --cached config.json` 才真正移出版本库。
/config.json

# 第三方参考 demo 仓库（独立 git 仓库，不纳入主仓库）
engine-reference/Godot-Demos/

# --- 以下为 2026-09-02 补充 ---
# 注意：这些路径中已有一部分此前被 git 跟踪（*.tmp 4 个、根目录 *.exe/*.pck、
# chm_extract/）。写入 .gitignore 只会阻止**新文件**被加入，不会自动取消跟踪。
# 需要真正移出版本库时请单独执行（会 staged 大量删除，务必先确认）：
#   git rm -r --cached "bird's-eye_view-ARPG test.exe" \
#       "bird's-eye_view-ARPG test.console.exe" "bird's-eye_view-ARPG test.pck" \
#       chm_extract/ "object/enemy.tscn647636915.tmp" \
#       "scene/maps/test.tscn164599960.tmp" "scene/maps/test.tscn2208483626.tmp" \
#       "scene/vx_test.tscn7245302921.tmp"

# 导出产物（根目录打包结果，约 200MB，不应进入版本库）
/*.exe
/*.pck
/build/

# 导出发布包目录（约 190MB：exe + pck，由 export_presets.cfg 产出）
/发布包*/

# 临时评审产物（diff 转储等，非项目源文件）
/tmpcheck_review/

# Godot 运行时用户数据（无头/编辑器运行日志，非项目源文件）
/Godot/

# Godot 编辑器临时备份（崩溃恢复残留）
*.tmp

# 联机无头测试临时目录（历史遗留，当前为空）
/.tmp-user-client/
/.tmp-user-host/

# 联机回归日志（tools/net_regression.py 产出）
/tools/net_regression_logs/
# 归档的旧回归日志（2026-10-03：沙箱按「本轮累计删除数」计，脚本收尾清理日志会撞阈值 →
# 跑回归前把旧目录改名归档、并用 `--keep-logs` 跳过清理；这些归档同样不该进版本库）
/tools/net_regression_logs_archive_*/

# Python 工具链缓存
__pycache__/
*.pyc

# CHM 解压产物（由 rpg2003.chm 派生，可随时重建）
/chm_extract/

# 本地 AI 助手工作目录（不纳入版本库）
/.claude/
/.workbuddy/
/.zcode/

# 第三方工具二进制（本地自备，不入库）
tools/**/*.exe

# Master Server 部署打包产物（由 tar 现场生成，不入库）
/master-server.tar.gz
/master-server.zip

# CHM 帮助文档源（6MB，chm_extract/ 已由其派生）
/rpg2003.chm
.workbuddy/
# ── 发布产物目录：整目录排除（.gdignore 已被跟踪，保留）──
# 2026-10-07：补 *.zip（约 96MB 分发包）与运行期杂项；exe/apk/pck 此前已排除
release/*.exe
release/*.apk
release/*.pck
release/*.zip
release/config.json
release/l3d_error_log.txt

# 外部工具目录（Trae 等第三方 AI 工具的工作文件，非项目源）
# ⚠ 但 `.trae/skills/` 是本项目**主动维护**的复用流程（部署/验收等），需要入库共享；
# 故逐目录忽略，而不是整目录忽略。
/.trae/documents/
/.trae/*.md

# 安卓签名密钥库 —— 切勿入库（泄露 = 别人能冒名签发你的应用）
*.keystore
*.jks
# 导出预设：里面存着发布密钥库口令，而本仓库是**公开**的 → 只保留在本地
export_presets.cfg
# 导出预设的手改备份
export_presets.cfg.bak
