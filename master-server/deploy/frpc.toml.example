# ── L3D 房主侧的 frpc 配置（跑在**房主自己的电脑**上）──
#
# 作用：把房主本机的游戏 UDP 端口，映射到公网服务器（frps）的一个远程端口，
# 让外网玩家能连进来 —— 这就是"房主可达性"（互联网联机模式策划方案.md §2）。
#
# ⚠ 复制成 `frpc.toml` 后，改这三处：
#     ① serverAddr  —— 你的服务器公网 IP
#     ② auth.token  —— 必须与服务器 frps.toml 里的 auth.token **完全一致**
#     ③ remotePort  —— 在服务器 allowPorts 范围内挑一个**没被占用**的

serverAddr = "8.138.99.96"
serverPort = 7000

auth.method = "token"
auth.token = "与服务器 frps.toml 里的 auth.token 完全一致"

# 必须与服务端一致（见 frps.toml.example 里的详细说明：ENet MTU=1392）
udpPacketSize = 1500

[[proxies]]
name = "l3d-game-udp"
type = "udp"
localIP = "127.0.0.1"
# 你在游戏大厅「创建房间端口」里填的那个端口（本机 UDP 监听端口）
localPort = 27015
# frps 上对外暴露的端口：在服务器 allowPorts 范围内、且当前没别人用
remotePort = 27015
