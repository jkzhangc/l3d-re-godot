# L3D host-side frpc config (runs on the HOST's own PC).
# Deploy steps: see DEPLOY-FRPS.md in the same directory.
# NOTE: keep this file ASCII-only. frp's TOML parser rejects non-ASCII
#       characters inside comments (error: "invalid character in comment").
#
# What it does: maps the host's local game UDP port to a public port on the
# frps server, so players on the Internet can reach the host. This is the
# "host reachability" half of Internet play (plan doc section 2).
#
# After copying to frpc.toml, change these three:
#   1) serverAddr  -> your server's public IP
#   2) auth.token  -> MUST match auth.token in the server's frps.toml
#   3) remotePort  -> pick one inside the server's allowPorts that is free

serverAddr = "8.138.99.96"
serverPort = 7000

auth.method = "token"
auth.token = "MUST_MATCH_THE_SERVER_FRPS_TOKEN"

# Must match the server value (see frps.toml.example: ENet MTU = 1392).
udpPacketSize = 1500

[[proxies]]
name = "l3d-game-udp"
type = "udp"
localIP = "127.0.0.1"
# The port you typed as "create room port" in the in-game lobby (local UDP listen port).
localPort = 27015
# The port exposed on the frps server: inside allowPorts and currently unused.
remotePort = 27015
