# ── L3D 互联网联机的 frps 服务端配置 ──
# 放在**有公网 IP 的服务器**上（本项目：8.138.99.96）。
# 部署步骤见同目录 `DEPLOY-FRPS.md`。
#
# ⚠ 这是模板：复制成 `frps.toml` 后，**务必**改掉 `auth.token`。

bindAddr = "0.0.0.0"
bindPort = 7000

# ★★ 最关键的一项：UDP 单包上限（默认即 1500）。
#
# 为什么必须在意它：ENet 的 MTU 是 **1392**，所有 RPC 都被自动分片到 ≤1392。
# 本机实测（互联网联机模式策划方案.md §12.2）：
#   · 上限 1500 / 1400 → 可靠 RPC 正常（观测到最大单包 1392）
#   · 上限 1300        → **可靠 RPC 永远不到**，表现为"握手能过、之后整个可靠通道
#                        静默停摆"，客户端只显示"连不上"，极难排查
# 即：**服务端与客户端必须一致，且不得低于 1400**。
udpPacketSize = 1500

# 鉴权：房主侧的 frpc 必须填**完全相同**的 token 才能接入。
auth.method = "token"
auth.token = "CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# 只允许代理绑定这些远程端口 —— 防止有人拿你的服务器转发任意端口。
# M1 做法：给房主一段 UDP 端口范围，房主自己挑一个空闲的，填进游戏大厅。
# 16 个端口足够 M1 的开发者自建局；并发房主更多时把范围放大即可。
allowPorts = [
  { start = 27015, end = 27030 },
]

# 面板（可选）。
# 默认绑 127.0.0.1：只有 SSH 进服务器才能访问，最安全。
# 想从公网看就改成 "0.0.0.0" 并在控制台防火墙放行 7500，**同时务必设强密码**。
webServer.addr = "127.0.0.1"
webServer.port = 7500
webServer.user = "admin"
webServer.password = "CHANGE_ME"

log.to = "console"
log.level = "info"
log.maxDays = 3
