# L3D frps server config (Internet play: host reachability via UDP relay).
# Deploy steps: see DEPLOY-FRPS.md in the same directory.
# NOTE: keep this file ASCII-only. frp's TOML parser rejects non-ASCII
#       characters inside comments (error: "invalid character in comment").
#
# WARNING: this is a template. After copying to frps.toml, CHANGE auth.token.

bindAddr = "0.0.0.0"
bindPort = 7000

# MOST IMPORTANT: UDP packet size limit (default 1500, do NOT lower it).
#
# Why it matters: ENet's MTU is 1392, so every RPC is fragmented to <= 1392 bytes.
# Measured locally (plan doc section 12.2):
#   - limit 1500 / 1400 -> reliable RPC works (max packet observed: 1392)
#   - limit 1300        -> reliable RPC NEVER arrives. Symptom: handshake succeeds,
#                          then the whole reliable channel goes silent, and the
#                          client only reports "cannot connect" - very hard to debug.
# Server and client values MUST match and MUST be >= 1400.
udpPacketSize = 1500

# Auth: the host-side frpc must use the EXACT same token.
auth.method = "token"
auth.token = "CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Only allow proxies to bind these remote ports, so nobody can relay arbitrary
# ports through your server. M1: hand hosts a UDP port range; each host picks
# one free port and types it into the in-game lobby form.
allowPorts = [
  { start = 27015, end = 27030 },
]

# Dashboard (optional). Bound to 127.0.0.1 = reachable only via SSH (safest).
# To expose it, set "0.0.0.0" and open TCP 7500 in the firewall,
# but then you MUST set a strong password.
webServer.addr = "127.0.0.1"
webServer.port = 7500
webServer.user = "admin"
webServer.password = "CHANGE_ME"

log.to = "console"
log.level = "info"
log.maxDays = 3
