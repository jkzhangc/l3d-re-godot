## 场景路径关键词 → 台词表 key（按顺序匹配，先命中先用）。
const SCENE_KEYS: Array = [
	## ⚠ 顺序即优先级：夜行猎手的三张「结束安全屋」用的是**结束**（突袭用**结尾**，不冲突），
	## 但「第一关-开头安全屋」两边同名 —— 必须让夜行猎手的具体路径先命中。
	["夜行猎手-第一关-开头安全屋", "night1_start"],
	["夜行猎手-第一关-结束安全屋", "night1_end"],
	["夜行猎手-第二关-结束安全屋", "night2_end"],
	["夜行猎手-第三关-结束安全屋", "night3_end"],
	["第一关-开头安全屋", "ch1_start"],
	["第一关-结尾安全屋", "ch1_end"],
	["第二关-结尾安全屋", "ch2_end"],
	["第三关-结尾安全屋", "ch3_end"],
]


## 该场景是否有安全屋台词；返回空串表示没有。
static func key_for_scene(scene_path: String) -> String:
	for pair: Array in SCENE_KEYS:
		if scene_path.contains(str(pair[0])):
			return str(pair[1])
	return ""


## 取「该图 × 该角色 × 该批次」的台词；取不到返回空数组（调用方据此保持安静）。
static func lines_for(key: String, char_id: String, stage: String = STAGE_ENTER) -> Array:
	if not DIALOGUES.has(key):
		return []
	var stages: Dictionary = DIALOGUES[key]
	if not stages.has(stage):
		return []
	var by_char: Dictionary = stages[stage]
	if not by_char.has(char_id):
		return []
	return by_char[char_id]


## 该图该批次里有台词的角色 id 列表（调试 / 探针用）。
static func characters_for(key: String, stage: String = STAGE_ENTER) -> Array:
	if not DIALOGUES.has(key):
		return []
	var stages: Dictionary = DIALOGUES[key]
	if not stages.has(stage):
		return []
	return (stages[stage] as Dictionary).keys()


## 取该角色的**页**：每页 = 一个批次的多行台词，**同一屏一起显示**。
##
## ★原作口径（2026-09-28 用户核对）：A 批与 B 批是**同一段对话的连续两页** ——
##   A 批先出，按确定键继续到 B 批，再按确定键关闭。
##   而**同一批次里的多行是同时显示的**（原作对话框一次显示说话人 + 数行正文），
##   不应该一句一屏地翻页。
##
## 返回：`Array[Array[String]]` —— 外层是页，内层是该页的多行。角色无台词时返回空数组。
static func pages_for(key: String, char_id: String) -> Array:
	var pages: Array = []
	for stage: String in [STAGE_ENTER, STAGE_AFTER_SUMMARY, STAGE_CLOSING]:
		var lines: Array = lines_for(key, char_id, stage)
		if not lines.is_empty():
			pages.append(lines)
	return pages


static func has_key(key: String) -> bool:
	return DIALOGUES.has(key)
