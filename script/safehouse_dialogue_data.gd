## 场景路径关键词 → 台词表 key（按顺序匹配，先命中先用）。
const SCENE_KEYS: Array = [
	## 死亡岛战役的开头安全屋（Map0025）—— 必须排在通用「第一关-开头安全屋」之前，
	## 否则会被突袭的 ch1_start 先命中。
	["死亡岛-第一关-开头安全屋", "death1_start"],
	["死亡岛-第一关-结束安全屋", "death1_end"],
	["死亡岛-第二关-结束安全屋", "death2_end"],
	["死亡岛-第三关-结束安全屋", "death3_end"],
	## ⚠ 顺序即优先级：夜行猎手的三张「结束安全屋」用的是**结束**（突袭用**结尾**，不冲突），
	## 但「第一关-开头安全屋」两边同名 —— 必须让夜行猎手的具体路径先命中。
	["夜行猎手-第一关-开头安全屋", "night1_start"],
	["夜行猎手-第一关-结束安全屋", "night1_end"],
	["夜行猎手-第二关-结束安全屋", "night2_end"],
	["夜行猎手-第三关-结束安全屋", "night3_end"],
	["第一关-开头安全屋", "ch1_start"],
	["第一关-结尾安全屋", "ch1_end"],
	["第二关-结尾安全屋", "ch2_end"],
	["第三关-结尾安全屋", "ch3_end"],
]


## 该场景是否有安全屋台词；返回空串表示没有。
static func key_for_scene(scene_path: String) -> String:
	for pair: Array in SCENE_KEYS:
		if scene_path.contains(str(pair[0])):
			return str(pair[1])
	return ""


## 按批次挑说话人（2026-11-24 用户需求：A/B/C 三页不能出现同一个角色）。
##
## 规则：
##   · 第 1 页从「该图第 1 批有台词」的候选里随机；
##   · 第 2 页从「第 2 批有台词、且没在第 1 页说过话」的候选里随机；
##   · 第 3 页同理，排除前两页的说话人。
## 池子不够（1~2 人小队：能说这批的人都被前面用过了）时**允许重复** ——
## 宁可重复也不能整页消失，单人局的安全屋台词必须照常出。
##
## `candidates` = 本局队伍里的角色 id。返回长度 = count；
## 某一项为空串 = 该批次谁都没台词，调用方跳过这一页。
static func pick_stage_speakers(key: String, candidates: Array[String], count: int) -> Array[String]:
	var out: Array[String] = []
	if count <= 0:
		return out
	var stages: Array[String] = [STAGE_ENTER, STAGE_AFTER_SUMMARY, STAGE_CLOSING]
	var used: Dictionary = {}
	for i: int in range(count):
		var stage: String = stages[i] if i < stages.size() else ""
		var fresh: Array[String] = []
		var fallback: Array[String] = []
		for cid: String in candidates:
			if cid.is_empty():
				continue
			if stage.is_empty() or lines_for(key, cid, stage).is_empty():
				continue
			fallback.append(cid)
			if not used.has(cid):
				fresh.append(cid)
		var bucket: Array[String] = fresh if not fresh.is_empty() else fallback
		if bucket.is_empty():
			out.append("")
			continue
		var pick: String = bucket[randi_range(0, bucket.size() - 1)]
		used[pick] = true
		out.append(pick)
	return out


## 取「该图 × 该角色 × 该批次」的台词；取不到返回空数组（调用方据此保持安静）。
static func lines_for(key: String, char_id: String, stage: String = STAGE_ENTER) -> Array:
	if not DIALOGUES.has(key):
		return []
	var stages: Dictionary = DIALOGUES[key]
	if not stages.has(stage):
		return []
	var by_char: Dictionary = stages[stage]
	if not by_char.has(char_id):
		return []
	return by_char[char_id]


## 该图该批次里有台词的角色 id 列表（调试 / 探针用）。
static func characters_for(key: String, stage: String = STAGE_ENTER) -> Array:
	if not DIALOGUES.has(key):
		return []
	var stages: Dictionary = DIALOGUES[key]
	if not stages.has(stage):
		return []
	return (stages[stage] as Dictionary).keys()


## 取该角色的**页**：每页 = 一个批次的多行台词，**同一屏一起显示**。
##
## ★原作口径（2026-09-28 用户核对）：A 批与 B 批是**同一段对话的连续两页** ——
##   A 批先出，按确定键继续到 B 批，再按确定键关闭。
##   而**同一批次里的多行是同时显示的**（原作对话框一次显示说话人 + 数行正文），
##   不应该一句一屏地翻页。
##
## 返回：`Array[Array[String]]` —— 外层是页，内层是该页的多行。角色无台词时返回空数组。
static func pages_for(key: String, char_id: String) -> Array:
	var pages: Array = []
	for stage: String in [STAGE_ENTER, STAGE_AFTER_SUMMARY, STAGE_CLOSING]:
		var lines: Array = lines_for(key, char_id, stage)
		if not lines.is_empty():
			pages.append(lines)
	return pages


static func has_key(key: String) -> bool:
	return DIALOGUES.has(key)


## 该图是否有固定的 NPC 台词（目前只有死亡岛第三关的多啦A梦）。
static func has_npc(key: String) -> bool:
	return DIALOGUES.has(key) and (DIALOGUES[key] as Dictionary).has("npc")


static func npc_name(key: String) -> String:
	if not DIALOGUES.has(key):
		return ""
	return str((DIALOGUES[key] as Dictionary).get("npc_name", ""))


## NPC 在该批次的页数组（外层一页、内层该页的多行）；没有返回空数组。
## ⚠ 统一返回「页数组」：单屏 NPC 台词也要写成 `[[...]]`，调用方不必再分支。
static func npc_pages_for(key: String, stage: String) -> Array:
	if not has_npc(key):
		return []
	var npc: Dictionary = (DIALOGUES[key] as Dictionary).get("npc", {})
	var value: Variant = npc.get(stage, [])
	return value if value is Array else []
